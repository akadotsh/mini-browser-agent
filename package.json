{
  "name": "mini-browser-agent",
  "version": "0.1.0",
  "description": "Lightweight AI browser automation CLI powered by Bun",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akadotsh/mini-browser-agent.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": ["src", "chrome-extension", "examples"],
  "bin": {
    "mini-browser-agent": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target=bun --outdir=dist"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.75",
    "ai": "^7.0.148",
    "zod": "^4.6.7"
  }
}
